# Required for AI analysis and application startup
OPENAI_API_KEY=

# Optional SMTP configuration for Email Session.
# SMTP_HOST, SMTP_PORT, and SMTP_FROM_EMAIL are required when email is enabled.
# SMTP_USERNAME and SMTP_PASSWORD must either both be set or both be blank.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
